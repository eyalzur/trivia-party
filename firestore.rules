rules_version = '2';

// Trust model: players are friends in the same room. Rules stop randoms
// off the internet from touching data, and stop a buzz's timestamp from
// being spoofed by the client (the one thing that actually decides a
// round). They do not try to stop a dishonest player from editing their
// own score field directly.
service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{code} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;

      match /players/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.avatar is string
          && request.resource.data.score == 0;
        allow update: if request.auth != null;
        allow delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if false;

        match /buzzes/{uid} {
          allow read: if true;
          allow create: if request.auth != null && request.auth.uid == uid
            && request.resource.data.at == request.time;
          allow update: if request.auth != null;
          allow delete: if false;
        }
      }
    }
  }
}
